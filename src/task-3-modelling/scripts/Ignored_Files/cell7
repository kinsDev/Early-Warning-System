    sns.kdeplot(data=y_true[:, month, 0], label=f'Actual Month {month+1}')
    sns.kdeplot(data=y_pred[:, month, 0], label=f'Predicted Month {month+1}', linestyle='--')
ax.set_title('Distribution of Values by Month')
