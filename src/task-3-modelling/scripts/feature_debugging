def inspect_processed_data(processed_data):
    print("\nProcessed Data Overview:")
    print("-" * 50)
    for key, df in processed_data.items():
        print(f"\nDataset: {key}")
        print("Shape:", df.shape)
        print("\nNumerical columns sample:")
        print(df.select_dtypes(include=['float64', 'int64']).head())
        print("\nCategorical columns sample:")
        print(df.select_dtypes(include=['object']).head())
        print("\nMissing values count:", df.isnull().sum().sum())

