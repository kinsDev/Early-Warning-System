from typing import Dict
from sklearn.impute import SimpleImputer
import pandas as pd

class FeatureEngineering:
    def __init__(self, config):
        self.config = config

    def process_features(self, df: pd.DataFrame) -> Dict[str, pd.DataFrame]:
        base_features = self._process_base_features(df)
        temporal_features = self._create_temporal_features(base_features)

        return {
            'base': base_features,
            'temporal': temporal_features,
            'lstm': self._prepare_lstm_features(temporal_features),
            'prophet': self._prepare_prophet_features(temporal_features)
        }

    def _process_base_features(self, df):
        df = df.copy()
        for group_name, features in self.config.feature_groups.items():
            for col in features:
                if df[col].dtype == 'object':
                    if col in ['YYYY_MM', 'Country', 'Iso3', 'Region', 'Crisis Id', 'Crisis']:
                        continue
                    df[col] = df[col].replace('x', 0)
                    df[col] = pd.to_numeric(df[col], errors='coerce')
        return df

    def _create_temporal_features(self, df):
        df = df.copy()
        df['year'] = pd.to_datetime(df['YYYY_MM'], format='%Y_%m').dt.year
        df['month'] = pd.to_datetime(df['YYYY_MM'], format='%Y_%m').dt.month
        return df

    def _prepare_lstm_features(self, df):
        df_lstm = df.copy()
        numeric_cols = df_lstm.select_dtypes(include=['float64', 'int64']).columns
        df_lstm = df_lstm[numeric_cols]
        return df_lstm

    def _prepare_prophet_features(self, df):
        df_prophet = df.copy()
        df_prophet['ds'] = pd.to_datetime(df_prophet['YYYY_MM'], format='%Y_%m')
        return df_prophet

class DataPreprocessor:
    def __init__(self, config):
        self.config = config
        self.numerical_imputer = SimpleImputer(strategy='mean')
        self.categorical_imputer = SimpleImputer(strategy='constant', fill_value='missing')

    def process_data(self, data_dict: Dict[str, pd.DataFrame]) -> Dict[str, pd.DataFrame]:
        processed = {}
        for key, df in data_dict.items():
            if isinstance(df, pd.DataFrame):
                processed[key] = self._process_base_features(df)
        return processed

    def _process_base_features(self, df):
        df = df.copy()
        df = self.handle_missing_values(df)
        return df

    def handle_missing_values(self, df):
        df = df.copy()
        valid_columns = df.columns[df.notna().any()]
        df = df[valid_columns]

        numerical_cols = df.select_dtypes(include=['float64', 'int64']).columns
        if len(numerical_cols) > 0:
            valid_numerical_cols = [col for col in numerical_cols if df[col].notna().any()]
            if valid_numerical_cols:
                numerical_data = self.numerical_imputer.fit_transform(df[valid_numerical_cols])
                df[valid_numerical_cols] = numerical_data

        categorical_cols = df.select_dtypes(include=['object']).columns
        if len(categorical_cols) > 0:
            valid_categorical_cols = [col for col in categorical_cols if df[col].notna().any()]
            if valid_categorical_cols:
                categorical_data = self.categorical_imputer.fit_transform(df[valid_categorical_cols])
                df[valid_categorical_cols] = categorical_data

        return df

class DataLoader:
    def __init__(self, config):
        self.config = config

    def prepare_features_targets(self, processed_data):
        # Use the base processed data for feature/target preparation
        df = processed_data['base']

        targets = {}
        target_columns = []

        # Extract targets
        for target_name, target_info in self.config.targets.items():
            target_cols = target_info['columns']
            targets[target_name] = df[target_cols[0]]  # Take first column if multiple
            target_columns.extend(target_cols)

        # Prepare features (excluding target columns)
        features = df.drop(columns=target_columns, errors='ignore')

        return features, targets

def process_features(df, config):
    feature_engineer = FeatureEngineering(config)
    engineered_features = feature_engineer.process_features(df)

    preprocessor = DataPreprocessor(config)
    processed_data = preprocessor.process_data(engineered_features)

    data_loader = DataLoader(config)
    X, y = data_loader.prepare_features_targets(processed_data)

    feature_selector = FeatureSelector(config)
    selected_features = feature_selector.select_features(X, y)

    return processed_data, selected_features

